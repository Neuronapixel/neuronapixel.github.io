#usda 1.0
(
    defaultPrim = "Neuronapixel"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 360
    timeCodesPerSecond = 30
    framesPerSecond = 30
    documentation = "Neuronapixel: 27 red and white cubes, 15 cm wide, with a 12-second rotation. Generated from logo-mark.vue."
)

def Xform "Neuronapixel" (
    kind = "component"
)
{
    double3 xformOp:translate = (0, 0.075, 0)
    double3 xformOp:scale = (0.5, 0.5, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    def Scope "Materials"
    {

        def Material "Primary"
        {
            token outputs:surface.connect = </Neuronapixel/Materials/Primary/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.00000000, 0.02842604, 0.02842604)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.4
                float inputs:opacity = 1
                token outputs:surface
            }
        }

        def Material "Secondary"
        {
            token outputs:surface.connect = </Neuronapixel/Materials/Secondary/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.00000000, 1.00000000, 1.00000000)
                color3f inputs:emissiveColor = (0.4, 0.4, 0.4)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                float inputs:opacity = 1
                token outputs:surface
            }
        }
    }
    def Xform "Logo"
