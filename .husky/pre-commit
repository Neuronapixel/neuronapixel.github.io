#!/bin/sh

# Skip in CI environments
if [ "$CI" = "true" ]; then
  echo "ℹ️  Skipping pre-commit hook in CI"
  exit 0
fi

# Load nvm if available, otherwise fallback to system Node
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use || echo "⚠️  nvm is installed but no matching Node version found. Using default."
else
  echo "⚠️  nvm not found. Using system Node."
fi

# Run your checks
npm run lint
npm run test:coverage
